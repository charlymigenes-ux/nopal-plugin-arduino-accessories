#pragma once

// ============================================================================
// CREDENCIALES Y NOMBRE DE RED — PLANTILLA (LilyGo T-Call SIM800L IP5306)
// ============================================================================
//
// 1. Copia este archivo a "secrets.h" (mismo directorio).
// 2. Cambia los valores de abajo por los tuyos.
// 3. NO subas secrets.h al repositorio — ya está en .gitignore, pero
//    revisa igual antes de un "git add -A" si algo se ve raro.
//

// Red Wi-Fi de casa/taller a la que se va a conectar la placa.
// Si dejas "TU_RED_WIFI" tal cual, el firmware NO intenta conectarse y
// arranca directo en modo de recuperación (punto de acceso propio).
#define NOPAL_WIFI_SSID       "TU_RED_WIFI"
#define NOPAL_WIFI_PASSWORD   "TU_PASSWORD"

// Nombre con el que la placa se anuncia por mDNS: http://<esto>.local/
#define NOPAL_HOSTNAME        "nopal-tcall"

// Protegen el panel http://IP/update (ElegantOTA) y los endpoints
// /api/relay, /api/led, /api/sms, /api/modem/restart.
#define NOPAL_OTA_USERNAME    "nopal"
#define NOPAL_OTA_PASSWORD    "cambia-esta-clave"

// Contraseña del punto de acceso de recuperación (NOPAL-TCALL-XXXXXX) que
// la placa levanta sola cuando no hay credenciales configuradas o no logra
// conectarse a NOPAL_WIFI_SSID. Debe tener al menos 8 caracteres.
#define NOPAL_AP_PASSWORD     "nopal-setup"

// PIN de la SIM, si tiene uno configurado. Déjalo vacío ("") si la SIM no
// pide PIN -- es lo normal para una SIM ya usada antes.
#define NOPAL_SIM_PIN         ""

// APN de datos móviles de tu operador (necesario solo para GPRS -- SMS y
// llamadas no lo requieren). Si dejas "TU_APN" tal cual, el firmware no
// intenta conectar GPRS. Ejemplos típicos en México: "internet.itelcel.com"
// (Telcel), "webgprs.attmex.mx" (AT&T), "internet.movistar.mx" (Movistar).
#define NOPAL_GPRS_APN        "TU_APN"
#define NOPAL_GPRS_USER       ""
#define NOPAL_GPRS_PASSWORD   ""
