#pragma once

// ============================================================================
// CREDENCIALES Y NOMBRE DE RED — PLANTILLA
// ============================================================================
//
// 1. Copia este archivo a "secrets.h" (mismo directorio).
// 2. Cambia los valores de abajo por los tuyos.
// 3. NO subas secrets.h al repositorio — ya está en .gitignore, pero
//    revisa igual antes de un "git add -A" si algo se ve raro.
//

// Red Wi-Fi de casa/taller a la que se va a conectar la placa.
// Si dejas "TU_RED_WIFI" tal cual, el firmware NO intenta conectarse y
// arranca directo en modo de recuperación (punto de acceso propio).
#define NOPAL_WIFI_SSID       "TU_RED_WIFI"
#define NOPAL_WIFI_PASSWORD   "TU_PASSWORD"

// Nombre con el que la placa se anuncia por mDNS: http://<esto>.local/
#define NOPAL_HOSTNAME        "nopal-accessory-ff"

// Protegen el panel http://IP/update (ElegantOTA), el panel principal
// http://IP/ y todos los endpoints de control (/api/relay, /api/led,
// /api/buzzer).
#define NOPAL_OTA_USERNAME    "nopal"
#define NOPAL_OTA_PASSWORD    "cambia-esta-clave"

// Contraseña del punto de acceso de recuperación (NOPAL-XXXXXX) que la
// placa levanta sola cuando no hay credenciales configuradas o no logra
// conectarse a NOPAL_WIFI_SSID. ElegantOTA sigue protegido aparte por
// NOPAL_OTA_USERNAME/NOPAL_OTA_PASSWORD. Debe tener al menos 8 caracteres.
#define NOPAL_AP_PASSWORD     "nopal-setup"

// Nombres de los relés que se muestran en el panel web (http://IP/) --
// opcionales, descomenta y edita solo los que quieras cambiar. Si no se
// definen, el firmware usa "Relé 1".."Relé 4" por defecto.
// #define NOPAL_RELAY1_NAME "Ventilador"
// #define NOPAL_RELAY2_NAME "Extractor"
// #define NOPAL_RELAY3_NAME "Compresor"
// #define NOPAL_RELAY4_NAME "Bomba"

// Polaridad de los módulos de relé (opcional). Por defecto el firmware
// asume que se activan con LOW (NOPAL_RELAY_ACTIVE_LOW=1), que es lo más
// común en los módulos genéricos de 1/2/4/8 canales. Si al prender un relé
// desde NOPAL el estado físico real queda invertido respecto al que
// reporta el panel/`/api/status` (confirmado que pasa con algunos módulos
// pensados para ESP32/NodeMCU, que se activan con HIGH), descomenta esta
// línea y ponela en 0. Cada placa tiene su propio secrets.h, así que si
// tenés dos placas con módulos de relé distintos, cada una puede usar el
// valor que le corresponda.
// #define NOPAL_RELAY_ACTIVE_LOW 1

// Buzzer activo (opcional) -- descomenta solo si quieres cambiar el
// comportamiento por defecto. Si no se definen, el firmware asume un
// buzzer activo en HIGH (NOPAL_BUZZER_ACTIVE_HIGH=1) y hace sonar un
// patrón cada vez que se aplica una escena rápida desde el panel web
// (NOPAL_BUZZER_SCENE_SOUNDS=1). El PIN del buzzer NO se configura acá:
// depende de la placa (ESP32 usa GPIO4, ESP8266 usa GPIO0/D3) y se elige
// junto con el resto del mapa de pines dentro de Nopal_FF.ino -- ver el
// comentario de BUZZER_PIN en la sección "CONFIGURACIÓN DE PINES".
// #define NOPAL_BUZZER_ACTIVE_HIGH 1
// #define NOPAL_BUZZER_SCENE_SOUNDS 1

// Si tu buzzer es PASIVO (2 pines, sin oscilador propio -- necesita una
// señal PWM oscilando para sonar, no un simple HIGH/LOW) en vez de activo,
// descomenta esto. NOPAL_BUZZER_ACTIVE_HIGH se ignora en modo pasivo (no
// aplica: no hay "nivel activo", hay "tono o silencio").
// #define NOPAL_BUZZER_PASSIVE 1
// #define NOPAL_BUZZER_TONE_HZ 2700

// MAC de la pantalla LED BLE (formato "AA:BB:CC:DD:EE:FF") -- solo tiene
// efecto en placas ESP32 (el ESP8266 no tiene radio Bluetooth, la función
// queda desactivada sola). Se obtiene con la app iPixel Color (pantalla
// vinculada -> información del dispositivo) o con un escáner BLE genérico
// como nRF Connect -- este firmware NO escanea, solo se conecta directo a
// una MAC ya conocida. Si se deja vacío (por defecto) la función queda
// desactivada por completo.
// #define NOPAL_BLE_SCREEN_MAC "AA:BB:CC:DD:EE:FF"

// Buzzer presente en el hardware (opcional, solo ESP8266). En las placas
// ESP32 el resto del bloque de pines lo decide el tipo de placa, pero en
// esta familia de ESP8266 algunas unidades traen buzzer en D0/GPIO16 y
// otras no, así que se decide por unidad física acá. Por defecto: false.
// #define NOPAL_BUZZER_HW_PRESENT true

// ---------------------------------------------------------------------------
// CLÚSTER (opcional) -- ver nopal_cluster.h
// ---------------------------------------------------------------------------
//
// Varias placas NOPAL en la misma LAN se descubren por broadcast UDP y
// eligen una líder sola: gana la de mayor peso (ESP32 > ESP8266) y los
// empates se resuelven con la MAC más baja. Si la líder se cae, otra se
// promueve; cuando vuelve, reclama el puesto. Apagado por defecto: sin
// NOPAL_CLUSTER_ENABLE=1 todo el módulo queda no-op y no gasta ni RAM ni
// CPU.
//
// Todas las placas que deban verse entre sí necesitan el MISMO
// NOPAL_CLUSTER_ID; es lo que separa dos clústeres en una misma red.
// #define NOPAL_CLUSTER_ENABLE   1
// #define NOPAL_CLUSTER_ID       "nopal-taller"

// Puerto UDP del descubrimiento. Solo hay que tocarlo si algo más en la
// red ya usa el 49820. Debe coincidir en todas las placas del clúster.
// #define NOPAL_CLUSTER_UDP_PORT 49820

// Aviso a NOPAL cuando una placa entra o sale del clúster. Lo manda SOLO
// la placa maestra, y NOPAL lo anuncia en la Matriz LED. Sin esto el
// clúster funciona igual: NOPAL simplemente no se entera hasta que alguien
// abra el dashboard.
//
// El token lo genera NOPAL solo: Ajustes del plugin de Accesorios ->
// avisos de clúster (o GET /api/accessories/cluster/config). Tiene que ser
// el MISMO en todas las placas que puedan llegar a ser maestras -- o sea,
// en todas.
//
// NOPAL_SERVER_HOST es la IP del servidor NOPAL, no la de ninguna placa.
// #define NOPAL_SERVER_HOST            "192.168.0.86"
// #define NOPAL_SERVER_PORT            8420
// #define NOPAL_CLUSTER_WEBHOOK_TOKEN  "pegá-acá-el-token-de-NOPAL"


// ---------------------------------------------------------------------------
// MONITOR DE BATERÍA (opcional, solo ESP32) -- ver nopal_power.h
// ---------------------------------------------------------------------------
//
// Para placas alimentadas por el módulo "UNIT Cargador de Batería LiPo
// Boost & I2C". El único chip que habla I2C ahí es el MAX17048 (fuel
// gauge); el firmware lo lee y lo publica en GET /api/power, que es de
// donde NOPAL saca la ficha de batería del panel de accesorios. Apagado
// por defecto: sin esto el bus I2C ni se toca.
// #define NOPAL_POWER_MONITOR_ENABLE 1

// Pines del bus I2C hacia el MAX17048. Por defecto SDA=33, SCL=13.
// #define NOPAL_POWER_SDA_PIN 33
// #define NOPAL_POWER_SCL_PIN 13

// Corrección de voltaje, en volts, que se SUMA a la lectura cruda del
// chip. El MAX17048 mide en su propio pin, no en los bornes de la celda,
// así que el cableado y el módulo le meten un error de offset constante
// (la escala es exacta por datasheet, no hace falta tocarla). Es un valor
// POR PLACA: medí la celda con un multímetro, comparalo con lo que
// reporta /api/power y poné la diferencia con su signo. Sin esto, el dato
// sale crudo (offset 0), que es lo correcto para una placa sin calibrar.
// #define NOPAL_POWER_VOLTAGE_OFFSET_V -0.095f

// Hibernación del medidor. El MAX17048 entra solo en modo ahorro cuando ve
// poca actividad y pasa a medir cada ~45 s en vez de cada 250 ms. En una
// placa que hace de no-break eso es contraproducente: si se va la luz, el
// ritmo de descarga tarda casi un minuto en reflejarse. Por eso el firmware
// la deshabilita POR DEFECTO. Ponelo en 0 solo si te importa más el ahorro
// de microamperes que la frescura del dato.
// #define NOPAL_POWER_DISABLE_HIBERNATE 0

// Umbral de batería baja, en porcentaje (1..32, por defecto 15). Al cruzarlo
// hacia abajo el chip levanta la bandera "soc_low" que se ve en /api/power.
// No dispara nada por sí solo (el pin ALRT no está cableado): es para que
// NOPAL pueda reaccionar desde el panel.
// #define NOPAL_POWER_ALERT_SOC_PCT 20
